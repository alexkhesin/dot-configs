([nil nil ((#("# Update local environment (most importantly DISPLAY and SSH_AUTH_SOCK) when
# reattaching from a different ssh / x11 session.  Without this, X11 programs
# do not work when tmux session is started from e.g. work and then attached to
# from home.
#
# Code clipped from a combination of
# http://www.johntobin.ie/blog/2011/06/Updating_environment_variables_from_tmux/
# and https://raim.codingfarm.de/blog/2013/01/30/tmux-update-environment/
tmux_update_env() {
  local _tmux_env
  _tmux_env=$(tmux show-environment)
  if [[ \"${_tmux_env}\" != \"${_expected_tmux_env}\" ]]; then
    if [[ -n \"${_expected_tmux_env}\" ]]; then
      local v
      echo \"updated local environment from tmux\"
      while read v; do
        if [[ $v == -* ]]; then
          unset ${v/#-/}
        else
          # Add quotes around the argument
          v=${v/=/=\\\"}
          v=${v/%/\\\"}
          export $v
        fi
      done < <(tmux show-environment)
    fi
    _expected_tmux_env=\"${_tmux_env}\"
  fi
}

precmd() {
  # detect if running under tmux
  if [ -n \"${TMUX}\" ]; then
# alexk: does not work, need to debug why
#    tmux_update_env
  fi
}
