# --- Typography ---
font-family = "JetBrains Mono"

# --- Appearance & Window ---
theme = "Gruvbox Dark"
window-padding-x = 6
window-padding-y = 6
scrollbar = never

# macOS clean titlebar (uncomment on macOS if desired)
# macos-titlebar-style = hidden

# --- Cursor & Mouse ---
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1
copy-on-select = false

# --- Splits ---
# Dims inactive terminal splits (native Ghostty splits)
unfocused-split-opacity = 0.70

# --- Buffer & Clipboard ---
scrollback-limit = 100_000

# Deny unprompted clipboard reads (prevents silent exfiltration of secrets/passwords)
clipboard-read = deny
# But writing is always useful
clipboard-write = allow