# --- Typography ---
font-family = "JetBrains Mono"

# --- Appearance & Window ---
theme = "Gruvbox Dark"
window-padding-x = 6
window-padding-y = 6
scrollbar = never

# --- Cursor & Mouse ---
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1

# copy-on-select is left at its default: on Linux, selections go to PRIMARY
# (middle-click); on macOS, selecting copies nothing.

# --- Buffer & Clipboard ---
# Scrollback inside tmux belongs to tmux; Ghostty's own default (10 MB) covers
# shells outside tmux. Note that scrollback-limit is in bytes, not lines.

# Deny unprompted clipboard reads (prevents silent exfiltration of secrets/passwords).
# Writes are allowed by default.
clipboard-read = deny
