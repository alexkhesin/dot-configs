# --- SSH shell integration ---
#   ssh-env:      fall back to TERM=xterm-256color, forward COLORTERM/TERM_PROGRAM
#   ssh-terminfo: install xterm-ghostty terminfo on remote hosts (cached;
#                 see `ghostty +ssh-cache`)
#
# Hosts without `tic` (e.g. Synology NAS) fail with "InstallFailed" on every
# connect. Install the compiled entry by hand (HOST=user@host):
#
#   infocmp -x xterm-ghostty > /tmp/ghostty.ti
#   tic -x -o /tmp/ghostty-terminfo /tmp/ghostty.ti
#   command ssh $HOST 'mkdir -p ~/.terminfo/x ~/.terminfo/78'
#   for d in x 78; do
#     command ssh $HOST "cat > ~/.terminfo/$d/xterm-ghostty" \
#       < /tmp/ghostty-terminfo/78/xterm-ghostty
#   done
#   ghostty +ssh-cache --add=$HOST
#
# (`command ssh` bypasses the Ghostty ssh wrapper; x/ and 78/ cover both
# letter and hex terminfo dir layouts. Verify on remote: echo $TERM)

# Do not enable `sudo` integration, it causes problems with corp setup
# (search for "sorry, you are not allowed to preserve the environment")
shell-integration-features = ssh-env,ssh-terminfo

# --- Typography ---
font-family = "JetBrains Mono"

# --- Appearance & Window ---
theme = "Gruvbox Dark"
window-padding-x = 6
window-padding-y = 6
scrollbar = never

# --- Cursor & Mouse ---
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1

# copy-on-select is left at its default: on Linux, selections go to PRIMARY
# (middle-click); on macOS, selecting copies nothing.

# --- Buffer & Clipboard ---
# Scrollback inside tmux belongs to tmux; Ghostty's own default (10 MB) covers
# shells outside tmux. Note that scrollback-limit is in bytes, not lines.

# Deny unprompted clipboard reads (prevents silent exfiltration of secrets/passwords).
# Writes are allowed by default.
clipboard-read = deny
